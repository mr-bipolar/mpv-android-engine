+// Forwards mpv_event_end_file{reason,error} so Java can tell EOF / STOP / ERROR apart.
+// Must be sent BEFORE the plain END_FILE event (the Java side pairs them).
+static void sendEndFileToJava(JNIEnv *env, mpv_event_end_file *ef)
+{
+    env->CallStaticVoidMethod(mpv_MPVLib, mpv_MPVLib_eventEndFile_ii, (jint) ef->reason, (jint) ef->error);
+}
+
 static void sendEventToJava(JNIEnv *env, int event)
 {
