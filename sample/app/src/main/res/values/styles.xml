<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="PlayerDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_black</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@color/white_alpha_75</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAppearanceListItemSmall">@style/PlayerDialogItemText</item>
        <item name="textColorAlertDialogListItem">@android:color/white</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="colorControlNormal">@color/white_alpha_55</item>
    </style>

    <style name="PlayerDialogItemText" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- Overflow (⋮) menu: black popup, white items -->
    <style name="PlayerPopupMenuTheme" parent="ThemeOverlay.AppCompat.Dark">
        <item name="popupMenuStyle">@style/PlayerPopupMenu</item>
        <item name="textAppearanceLargePopupMenu">@style/PlayerPopupItemText</item>
        <item name="textAppearanceSmallPopupMenu">@style/PlayerPopupItemText</item>
    </style>

    <style name="PlayerPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_black</item>
    </style>

    <style name="PlayerPopupItemText" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>


    <style name="PlayerGlassAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">#F4F7FF</item>
    </style>

</resources>