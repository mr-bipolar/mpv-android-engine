<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".player.MpvPlayerActivity">


    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <SurfaceView
            android:id="@+id/surface_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- GLASS CONTROLLER OVERLAY -->
        <FrameLayout
            android:id="@+id/playerControllers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_player_glass_scrim">

            <!-- TOP TOOLBAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_glass_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Back"
                    android:padding="11dp"
                    android:src="@drawable/ic_back"
                    app:tint="#FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- TITLE + LIVE BADGE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvLiveBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_glass_live"
                            android:paddingStart="7dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="7dp"
                            android:paddingBottom="3dp"
                            android:text="LIVE"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Channel name"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="HD Streaming"
                        android:textColor="#CCD2DF"
                        android:textSize="11sp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/btnFavorite"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_glass_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Favorite"
                    android:padding="11dp"
                    android:src="@drawable/ic_heart_outline"
                    app:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/btnMore"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_glass_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="More options"
                    android:padding="11dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="#FFFFFF" />

            </LinearLayout>

            <!-- CENTER PLAYBACK CONTROLS -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">


                <ImageView
                    android:id="@+id/btnPrev"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_glass_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Previous channel"
                    android:padding="14dp"
                    android:src="@drawable/ic_prev"
                    app:tint="#FFFFFF" />

                <FrameLayout
                    android:id="@+id/btnRewind"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_glass_circle"
                    android:clickable="true" android:focusable="true"
                    android:contentDescription="player_seek_back">
                    <ImageView
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:padding="9dp" android:src="@drawable/ic_seek"
                        android:scaleX="-1"
                        app:tint="#FFFFFF" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/playPause"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_glass_play"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/playPauseBtn"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Play or pause"
                        android:padding="19dp"
                        android:src="@drawable/ic_pause"
                        app:tint="#FFFFFF" />

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnForward"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_glass_circle"
                    android:clickable="true" android:focusable="true"
                    android:contentDescription="player_seek_back">
                    <ImageView
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:padding="9dp" android:src="@drawable/ic_seek"
                        app:tint="#FFFFFF" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/btnNext"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_glass_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Next channel"
                    android:padding="14dp"
                    android:src="@drawable/ic_next"
                    app:tint="#FFFFFF" />





            </LinearLayout>

            <!-- BOTTOM CONTROLS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_player_bottom_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <!-- LIVE / VOD STATUS SLOT -->
                <FrameLayout
                    android:id="@+id/statusRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp">

                    <!-- LIVE STATUS ROW -->
                    <LinearLayout
                        android:id="@+id/liveRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginBottom="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/liveDot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_circle_live" />

                        <TextView
                            android:id="@+id/tvLiveLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_glass_live"
                            android:paddingStart="7dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="7dp"
                            android:paddingBottom="3dp"
                            android:text="LIVE"
                            android:textColor="@color/white"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBufferInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:textColor="#CCD2DF"
                            android:textSize="10sp"
                            android:visibility="visible"
                            tools:text="Buffering · 24%" />

                    </LinearLayout>

                    <!-- VOD PROGRESS ROW -->
                    <LinearLayout
                        android:id="@+id/vodRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvPosition"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />

                        <SeekBar
                            android:id="@+id/videoProgress"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:max="1000"
                            android:progressTint="@color/accent"
                            android:thumbTint="#FFFFFF"
                            android:progressBackgroundTint="#66FFFFFF" />

                        <TextView
                            android:id="@+id/tvDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="#CCD2DF"
                            android:textSize="10sp" />

                    </LinearLayout>

                </FrameLayout>

                <!-- GLASS ACTION BAR -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <!-- AUDIO -->
                    <LinearLayout
                        android:id="@+id/btnAudio"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <ImageView
                            android:id="@+id/btnAudioIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_speaker"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Audio"
                            android:textColor="#CCD2DF"
                            android:textSize="9sp" />

                    </LinearLayout>

                    <!-- SUBTITLES -->
                    <LinearLayout
                        android:id="@+id/btnSubtitles"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <ImageView
                            android:id="@+id/btnSubtitlesIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_subtitles"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Subtitles"
                            android:textColor="#CCD2DF"
                            android:textSize="9sp" />

                    </LinearLayout>

                    <!-- SPEED -->
                    <LinearLayout
                        android:id="@+id/btnSpeed"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <ImageView
                            android:id="@+id/btnSpeedIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_clock"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:id="@+id/tvSpeedLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Speed"
                            android:textColor="#CCD2DF"
                            android:textSize="9sp"
                            tools:text="1.0x" />

                    </LinearLayout>

                    <!-- ASPECT RATIO -->
                    <LinearLayout
                        android:id="@+id/btnAspect"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <ImageView
                            android:id="@+id/btnAspectIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_aspect_ratio"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:id="@+id/tvAspectLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Aspect"
                            android:textColor="#CCD2DF"
                            android:textSize="9sp"
                            tools:text="FIT" />

                    </LinearLayout>

                    <!-- CHANNELS -->
                    <LinearLayout
                        android:id="@+id/btnChannels"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <ImageView
                            android:id="@+id/btnChannelsIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_channels_list"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Channels"
                            android:textColor="#CCD2DF"
                            android:textSize="9sp" />

                    </LinearLayout>

                    <!-- FULLSCREEN -->
                    <LinearLayout
                        android:id="@+id/btnFullscreen"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <ImageView
                            android:id="@+id/btnFullscreenIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_expand"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Fullscreen"
                            android:textColor="#CCD2DF"
                            android:textSize="9sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- BUFFERING INDICATOR -->
            <ProgressBar
                android:id="@+id/bufferingIndicator"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- ERROR PANEL -->
            <LinearLayout
                android:id="@+id/errorPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="28dp"
                android:background="@drawable/bg_glass_error"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_glass_circle">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_alert"
                        app:tint="@color/accent" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tvErrorTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Playback unavailable"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvErrorMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Check the stream and try again."
                    android:textColor="#CCD2DF"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↻"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Retry"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
